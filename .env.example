# =====================================================================
# WireGuard GUI - optional environment configuration
#
# This file is OPTIONAL. If you don't create it, the app will:
#   - generate and persist a session secret automatically, and
#   - show a first-run setup wizard in the browser to create the admin
#     account and configure the server.
#
# Copy to `.env` only if you want to override the defaults below.
# =====================================================================

# --- Application ---
PORT=3000
NODE_ENV=production
# Leave empty to auto-generate and persist a secret in DATA_DIR/.session-secret
SESSION_SECRET=
# Send session cookie only over HTTPS. Set to true when using TLS/reverse proxy.
COOKIE_SECURE=false

# --- Admin account ---
# Leave ADMIN_PASSWORD empty to use the first-run setup wizard.
# If you set a password here, the admin is created automatically on first
# start and the wizard is skipped (useful for headless/automation).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional shared token that must be entered to run the setup wizard.
SETUP_TOKEN=

# --- WireGuard server defaults (also editable in the wizard / Settings) ---
WG_INTERFACE=wg0
WG_SUBNET=10.8.0.0/24
WG_PORT=51820
# Public IP or domain that clients use to reach this server.
# "auto" lets you fill it from the setup wizard / Settings page.
WG_ENDPOINT=auto
WG_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0
WG_PERSISTENT_KEEPALIVE=25
WG_MTU=1420
# Outbound interface for NAT (auto-detected when empty)
WG_EGRESS_INTERFACE=
# Directory holding existing host WireGuard configs (mounted read-only) that the
# app can adopt during the first-run wizard.
HOST_WG_DIR=/etc/wireguard
# Use a userspace implementation (wireguard-go) when the kernel module is absent.
WG_USERSPACE_FALLBACK=true

# --- Data ---
DATA_DIR=./data

# --- Development ---
# Force mock mode (no real WireGuard binary needed). Useful on macOS.
MOCK_MODE=false
